rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /hospital_users/{userId} {
      allow read, write: if true;
    }

    match /hospital_patients/{patientId} {
      allow read, write: if true;
    }

    match /hospital_documents/{documentId} {
      allow read, write: if true;
    }

    match /hospital_clinical_notes/{noteId} {
      allow read, write: if true;
    }

    match /hospital_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /hospital_broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    match /hospital_care_plans/{planId} {
      allow read, write: if true;
    }

    match /hospital_attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /hospital_vital_records/{recordId} {
      allow read, write: if true;
    }

    match /app_config/{configId} {
      allow read, write: if true;
    }
  }
}
